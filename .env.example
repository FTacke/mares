# MARES -- maschinenspezifische Storage-Roots (nach `.env` kopieren; `.env` ist gitignored).
#
# Hier stehen nur Variablennamen. Kein realer Pfad und kein Secret gehört in diese versionierte
# Datei. Ein leerer Wert heißt NICHT KONFIGURIERT -- es gibt keinen Standardort und keinen
# Fallback. Rollen und Regeln: docs/architecture/storage-contract.md, config/storage_roots.toml.
# Jeder Wert ist ein absoluter, bereits existierender Ordner außerhalb jedes Git-Checkouts.

# WORKSPACE (Pflicht): regenerierbare Laufzeitdaten -- runs/, cache/, tmp/
MARES_WORKSPACE_ROOT=
# INTAKE (Pflicht): lokaler Eingangs- und Staging-Bereich -- inbox/, staging/, quarantine/, reports/
MARES_INTAKE_ROOT=
# PRIMARY (Pflicht für jede Arbeit mit echten Daten): autoritativer Forschungsdatenbestand
MARES_PRIMARY_ROOT=
# BACKUP (optional): unabhängige Zweitkopie von PRIMARY auf einem anderen Volume
MARES_BACKUP_ROOT=
# EXCHANGE (optional): synchronisierter Austauschordner (Nextbox); weder Archiv noch Backup
MARES_EXCHANGE_ROOT=
# LEGACY_IMPORT (optional): provisorischer Altbestand, nur lesend, nur für den Import-Run
MARES_LEGACY_IMPORT_ROOT=
